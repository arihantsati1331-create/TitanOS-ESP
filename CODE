TouchPoint readTouch() {
  TouchPoint out;
  if (!touch.touched()) {
    return out;
  }
  TS_Point raw = touch.getPoint();
  if (raw.z < TOUCH_MIN_PRESSURE) {
    return out;
  }

  out.down = true;
  out.rawX = raw.x;
  out.rawY = raw.y;
  out.z = raw.z;

  int32_t srcX = TOUCH_SWAP_XY ? raw.y : raw.x;
  int32_t srcY = TOUCH_SWAP_XY ? raw.x : raw.y;
  int16_t minX = TOUCH_SWAP_XY ? TOUCH_MIN_Y : TOUCH_MIN_X;
  int16_t maxX = TOUCH_SWAP_XY ? TOUCH_MAX_Y : TOUCH_MAX_X;
  int16_t minY = TOUCH_SWAP_XY ? TOUCH_MIN_X : TOUCH_MIN_Y;
  int16_t maxY = TOUCH_SWAP_XY ? TOUCH_MAX_X : TOUCH_MAX_Y;

  int32_t mappedX = map(srcX, minX, maxX, 0, tft.width() - 1);
  int32_t mappedY = map(srcY, minY, maxY, 0, tft.height() - 1);
  if (TOUCH_INVERT_X) mappedX = tft.width() - 1 - mappedX;
  if (TOUCH_INVERT_Y) mappedY = tft.height() - 1 - mappedY;

  out.x = clampToScreenX(mappedX);
  out.y = clampToScreenY(mappedY);
  return out;
}

