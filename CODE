void resetSnake() {
  snakeLen = 4;
  snakeDirX = 1;
  snakeDirY = 0;
  snakeOver = false;
  for (uint8_t i = 0; i < snakeLen; i++) {
    snakeX[i] = 5 - i;
    snakeY[i] = 5;
  }
  foodX = random(1, 15);
  foodY = random(1, 10);
}

void drawSnake() {
  appShell("Snake");
  tft.drawRect(8, 34, 208, 156, cPanel2());
  button({236, 74, 42, 28}, "^", cPanel2(), 2);
  button({190, 112, 42, 28}, "<", cPanel2(), 2);
  button({236, 112, 42, 28}, "v", cPanel2(), 2);
  button({282, 112, 32, 28}, ">", cPanel2(), 2);
