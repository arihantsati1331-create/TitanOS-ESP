}

void paintSnakeBoard() {
  tft.fillRect(9, 35, 206, 154, cBg());
  for (uint8_t i = 0; i < snakeLen; i++) {
    tft.fillRect(12 + snakeX[i] * 12, 38 + snakeY[i] * 12, 10, 10, ILI9341_GREEN);
  }
  tft.fillRect(12 + foodX * 12, 38 + foodY * 12, 10, 10, ILI9341_RED);
  if (snakeOver) centeredText("GAME OVER", 24, 96, 170, 18, ILI9341_RED, 2);
}

void stepSnake() {
  if (snakeOver) return;
  int8_t nx = snakeX[0] + snakeDirX;
  int8_t ny = snakeY[0] + snakeDirY;
  if (nx < 0 || nx > 16 || ny < 0 || ny > 12) {
    snakeOver = true;
    return;
  }
  for (uint8_t i = 0; i < snakeLen; i++) {
    if (snakeX[i] == nx && snakeY[i] == ny) {
      snakeOver = true;
      return;
    }
  }
  for (int8_t i = snakeLen; i > 0; i--) {
    snakeX[i] = snakeX[i - 1];
    snakeY[i] = snakeY[i - 1];
  }
  snakeX[0] = nx;
  snakeY[0] = ny;
  if (nx == foodX && ny == foodY) {
    if (snakeLen < 85) snakeLen++;
    foodX = random(1, 16);
    foodY = random(1, 12);
  }
}

void resetTTT() {
  for (uint8_t i = 0; i < 9; i++) ttt[i] = ' ';
  tttOver = false;
}

char tttWinner() {
  const uint8_t wins[8][3] = {{0,1,2},{3,4,5},{6,7,8},{0,3,6},{1,4,7},{2,5,8},{0,4,8},{2,4,6}};
  for (uint8_t i = 0; i < 8; i++) {
    char a = ttt[wins[i][0]];
    if (a != ' ' && a == ttt[wins[i][1]] && a == ttt[wins[i][2]]) return a;
  }
  for (uint8_t i = 0; i < 9; i++) if (ttt[i] == ' ') return 0;
  return 'D';
}

void drawTTT() {
  appShell("Tic Tac Toe");
  tft.drawRect(75, 42, 171, 171, cPanel2());
  tft.drawFastVLine(132, 42, 171, cPanel2());
  tft.drawFastVLine(189, 42, 171, cPanel2());
  tft.drawFastHLine(75, 99, 171, cPanel2());
  tft.drawFastHLine(75, 156, 171, cPanel2());
  for (uint8_t i = 0; i < 9; i++) {
    char s[2] = {ttt[i], '\0'};
    centeredText(s, 75 + (i % 3) * 57, 42 + (i / 3) * 57, 57, 57, ttt[i] == 'X' ? cAccent() : ILI9341_ORANGE, 3);
  }
  char w = tttWinner();
  if (w) {
    String msg;
    if (w == 'D') {
      msg = "Draw";
    } else {
      msg = String(w) + " wins";
    }
    centeredText(msg.c_str(), 0, 216, SCREEN_W, 14, cMuted(), 1);
    tttOver = true;
  }
}

