    int16_t y = (safeMode ? 82 : 62) + i * 20;
    tft.setCursor(16, y);
    tft.setTextColor(cText());
    String ssid = WiFi.SSID(i);
    if (ssid.length() > 18) ssid = ssid.substring(0, 18);
    tft.print(ssid);
    tft.setCursor(178, y);
    tft.setTextColor(cMuted());
    tft.print(WiFi.RSSI(i));
    tft.print(" dBm ch ");
    tft.print(WiFi.channel(i));
  }
}

void drawHttpText(const char *title, const char *url, const char *emptyText) {
  appShell(title);
  tft.setTextSize(1);
  tft.setTextColor(cText());
  if (url[0] == '\0') {
    centeredText(emptyText, 10, 75, 300, 20, cMuted(), 1);
    return;
  }
  if (WiFi.status() != WL_CONNECTED) {
    centeredText("WiFi is not connected.", 0, 74, SCREEN_W, 16, cMuted(), 1);
    centeredText("Use WiFi Mgr or set SSID/PASS.", 0, 94, SCREEN_W, 16, cMuted(), 1);
    return;
  }
  centeredText("Loading...", 0, 70, SCREEN_W, 16, cMuted(), 1);
  HTTPClient http;
  http.begin(url);
  int code = http.GET();
  tft.fillRect(10, 52, 300, 142, cBg());
  if (code <= 0) {
    centeredText("HTTP request failed", 0, 92, SCREEN_W, 16, ILI9341_RED, 1);
    http.end();
    return;
  }
  String payload = http.getString();
  http.end();
  payload.replace("\n", " ");
  tft.setCursor(16, 56);
  for (uint16_t i = 0; i < min((uint16_t)payload.length(), (uint16_t)260); i++) {
    tft.print(payload[i]);
    if (i % 42 == 41) tft.println();
  }
}

void drawFiles() {
  appShell("File Browser");
  if (!SPIFFS.begin(true)) {
    centeredText("SPIFFS mount failed", 0, 92, SCREEN_W, 16, ILI9341_RED, 1);
    return;
  }
  File root = SPIFFS.open("/");
  File file = root.openNextFile();
  uint8_t row = 0;
  while (file && row < 7) {
    String name = file.name();
    if (name.length() > 24) name = name.substring(0, 24);
    lineText(name.c_str(), String(file.size()) + " B", 48 + row * 20);
    file = root.openNextFile();
    row++;
  }
  if (row == 0) {
    centeredText("No SPIFFS files yet", 0, 95, SCREEN_W, 16, cMuted(), 1);
  }
}

