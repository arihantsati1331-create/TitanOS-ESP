bool inRect(const TouchPoint &p, const Rect &r) {
  return p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h;
}

int16_t clampToScreenX(int32_t v) { return constrain(v, 0, tft.width() - 1); }
int16_t clampToScreenY(int32_t v) { return constrain(v, 0, tft.height() - 1); }

void setBacklight(uint8_t value) {
  backlightValue = value;
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcWrite(PIN_TFT_LED, backlightValue);
#else
  ledcWrite(BACKLIGHT_CHANNEL, backlightValue);
#endif
}

void setupBacklight() {
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcAttach(PIN_TFT_LED, BACKLIGHT_FREQ, BACKLIGHT_BITS);
#else
  ledcSetup(BACKLIGHT_CHANNEL, BACKLIGHT_FREQ, BACKLIGHT_BITS);
  ledcAttachPin(PIN_TFT_LED, BACKLIGHT_CHANNEL);
#endif
  setBacklight(backlightValue);
}

void centeredText(const char *text, int16_t x, int16_t y, int16_t w, int16_t h,
                  uint16_t color, uint8_t size) {
  int16_t x1;
  int16_t y1;
  uint16_t tw;
  uint16_t th;
  tft.setTextSize(size);
  tft.getTextBounds(text, 0, 0, &x1, &y1, &tw, &th);
  tft.setTextColor(color);
  tft.setCursor(x + (w - tw) / 2, y + (h - th) / 2);
  tft.print(text);
}

