void calcKey(char key) {
  if (key >= '0' && key <= '9') {
    if (calcFresh || calcDisplay == "0") {
      calcDisplay = "";
      calcFresh = false;
    }
    if (calcDisplay.length() < 12) calcDisplay += key;
    drawCalc();
    return;
  }
  if (key == 'C') {
    calcDisplay = "0";
    calcLeft = 0;
    calcOp = 0;
    calcFresh = true;
    drawCalc();
    return;
  }
  if (key == '+' || key == '-' || key == '*' || key == '/') {
    calcLeft = calcDisplay.toDouble();
    calcOp = key;
    calcFresh = true;
    toast(String("Operator ") + key);
    return;
  }
  if (key == '=' && calcOp) {
    double right = calcDisplay.toDouble();
    double result = calcLeft;
    if (calcOp == '+') result += right;
    if (calcOp == '-') result -= right;
    if (calcOp == '*') result *= right;
    if (calcOp == '/' && right != 0) result /= right;
    calcDisplay = String(result, 2);
    calcOp = 0;
    calcFresh = true;
    drawCalc();
  }
}

