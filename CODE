void paintPong() {
  tft.fillRect(11, 35, 298, 168, cBg());
  tft.fillRect(pongAiX - 28, 42, 56, 5, ILI9341_ORANGE);
  tft.fillRect(pongPlayerX - 28, 194, 56, 5, cAccent());
  tft.fillCircle((int16_t)pongX, (int16_t)pongY, 4, cText());
}

void stepPong() {
  pongAiX += (pongX - pongAiX) * 0.08;
  pongX += pongVX;
  pongY += pongVY;
  if (pongX < 15 || pongX > 305) pongVX = -pongVX;
  if (pongY < 51 && abs((int)pongX - pongAiX) < 33) pongVY = abs(pongVY);
  if (pongY > 189 && abs((int)pongX - pongPlayerX) < 33) pongVY = -abs(pongVY);
  if (pongY < 34) {
    pongPlayerScore++;
    pongX = 160;
    pongY = 120;
  }
  if (pongY > 204) {
    pongAiScore++;
    pongX = 160;
    pongY = 120;
  }
}

void openApp(AppId id) {
  currentApp = id;
  animation();
  if (id == APP_CALC) drawCalc();
  if (id == APP_NOTES) drawNotes();
  if (id == APP_CLOCK) drawClock();
  if (id == APP_CALENDAR) drawCalendar();
  if (id == APP_WIFI_SCAN) drawWiFiList("WiFi Scanner", false);
  if (id == APP_WEATHER) drawHttpText("Weather", WEATHER_URL, "Set WEATHER_URL for live weather.");
  if (id == APP_FILES) drawFiles();
  if (id == APP_SNAKE) { resetSnake(); drawSnake(); paintSnakeBoard(); }
  if (id == APP_TTT) { resetTTT(); drawTTT(); }
  if (id == APP_PONG) { drawPong(); paintPong(); }
  if (id == APP_FEATURES) drawFeatures();
  if (id == APP_WIFI_MANAGER) drawWiFiManager();
  if (id == APP_BT) drawTextPage("Bluetooth Control", "Bluetooth control screen is ready.", "Add BluetoothSerial/BLE commands for", "your ESP32 board and project.", "Some ESP32-S3 boards have no classic BT.");
  if (id == APP_OTA) drawOTA();
  if (id == APP_WEB) drawHttpText("Web Browser", WEB_URL, "Set WEB_URL for a text page.");
  if (id == APP_MARAUDER) drawWiFiList("Safe Marauder Tools", true);
  if (id == APP_CAMERA) drawTextPage("Camera Support", "Needs ESP32-CAM or camera pins.", "This ESP32 DevKit wiring has no camera.", "Add esp_camera config for your board.", "Screen preview can be added next.");
  if (id == APP_PAINT) drawPaint();
  if (id == APP_TOUCH) drawTouchTest();
  if (id == APP_SETTINGS) drawSettings();
}

void handleLauncher(const TouchPoint &p, bool justPressed) {
  if (!justPressed) return;
  if (p.y >= TASKBAR_Y) {
    if (p.x < 75 && launcherPage > 0) {
      launcherPage--;
      drawLauncher();
    } else if (p.x > 245 && (launcherPage + 1) * APPS_PER_PAGE < APP_COUNT) {
      launcherPage++;
      drawLauncher();
    } else if (p.x > 115 && p.x < 205) {
      openApp(APP_SETTINGS);
    }
    return;
  }
  uint8_t col = p.x / 78;
  uint8_t row = (p.y - 34) / 57;
  if (p.y < 34 || row > 2 || col > 3) return;
  uint8_t index = launcherPage * APPS_PER_PAGE + row * 4 + col;
  if (index < APP_COUNT) openApp(APPS[index].id);
}

void handleCalc(const TouchPoint &p, bool justPressed) {
  if (!justPressed) return;
  if (p.y < 78) return;
  uint8_t col = (p.x - 18) / 74;
  uint8_t row = (p.y - 78) / 36;
  if (row > 3 || col > 3) return;
  const char keys[4][4] = {{'7','8','9','/'},{'4','5','6','*'},{'1','2','3','-'},{'C','0','=','+'}};
  calcKey(keys[row][col]);
}

void handleNotes(const TouchPoint &p, bool justPressed) {
  if (!justPressed) return;
  if (p.y >= 98 && p.y < 185) {
    uint8_t row = (p.y - 98) / 29;
    uint8_t col = p.x / 38;
    const char *rows[] = {"ABCDEFGH", "IJKLMNOP", "QRSTUVWX"};
    if (row < 3 && col < 8) noteAdd(rows[row][col]);
  } else if (p.y >= 185) {
    if (p.x < 43) noteAdd('Y');
    else if (p.x < 81) noteAdd('Z');
    else if (p.x < 158) noteAdd(' ');
    else if (p.x < 227 && noteLen > 0) {
      noteText[--noteLen] = '\0';
      drawNotes();
    } else if (p.x >= 237) {
      noteLen = 0;
      noteText[0] = '\0';
      drawNotes();
    }
  }
}

void handleWiFiManager(const TouchPoint &p, bool justPressed) {
  if (!justPressed) return;
  if (inRect(p, {25, 58, 125, 35})) {
    if (strlen(WIFI_SSID) == 0) {
      toast("Set WIFI_SSID/PASS first");
      return;
    }
    WiFi.mode(WIFI_STA);
    WiFi.begin(WIFI_SSID, WIFI_PASS);
    toast("Connecting...");
  } else if (inRect(p, {170, 58, 125, 35})) {
    WiFi.mode(WIFI_AP);
    WiFi.softAP("ESP32-MiniOS");
    drawWiFiManager();
    toast("Soft AP started");
  }
}

void handleOTA(const TouchPoint &p, bool justPressed) {
  if (!justPressed || !inRect(p, {86, 66, 148, 36})) return;
  if (WiFi.status() != WL_CONNECTED) {
    toast("WiFi needed for OTA");
    return;
  }
  ArduinoOTA.setHostname("esp32-minios");
  ArduinoOTA.begin();
  otaReady = true;
  drawOTA();
  toast("OTA ready");
}

void handleSettings(const TouchPoint &p, bool touched, bool justPressed) {
  if (touched && p.y >= 88 && p.y <= 111 && p.x >= 36 && p.x <= 284) {
    setBacklight(constrain(map(p.x, 36, 284, 5, 255), 5, 255));
    drawSettings();
  } else if (justPressed && inRect(p, {45, 153, 98, 34})) {
    darkMode = !darkMode;
    drawSettings();
  } else if (justPressed && inRect(p, {177, 153, 98, 34})) {
    toast("Notification test");
  }
}

void handlePaint(const TouchPoint &p, bool touched, bool justPressed) {
  if (justPressed && inRect(p, {49, 31, 67, 25})) {
    clearPaintCanvas();
    return;
  }
  if (justPressed && p.y >= 28 && p.y <= 58) {
    const uint16_t colors[] = {ILI9341_CYAN, ILI9341_RED, ILI9341_YELLOW, ILI9341_GREEN, ILI9341_WHITE};
    for (uint8_t i = 0; i < 5; i++) {
      int16_t cx = 143 + i * 31;
      int16_t dx = p.x - cx;
      int16_t dy = p.y - 43;
      if (dx * dx + dy * dy <= 14 * 14) {
        brushColor = colors[i];
        drawPaint();
        return;
      }
    }
  }
  if (touched && p.y > 66) tft.fillCircle(p.x, p.y, 3, brushColor);
}

void handleSnake(const TouchPoint &p, bool justPressed) {
  if (justPressed) {
    if (inRect(p, {236, 74, 42, 28}) && snakeDirY != 1) { snakeDirX = 0; snakeDirY = -1; }
    if (inRect(p, {236, 112, 42, 28}) && snakeDirY != -1) { snakeDirX = 0; snakeDirY = 1; }
    if (inRect(p, {190, 112, 42, 28}) && snakeDirX != 1) { snakeDirX = -1; snakeDirY = 0; }
    if (inRect(p, {282, 112, 32, 28}) && snakeDirX != -1) { snakeDirX = 1; snakeDirY = 0; }
    if (snakeOver && inRect(p, {8, 34, 208, 156})) resetSnake();
  }
  if (millis() - lastGameTick > 180) {
    stepSnake();
    paintSnakeBoard();
    lastGameTick = millis();
  }
}

void handleTTT(const TouchPoint &p, bool justPressed) {
  if (!justPressed) return;
  if (tttOver) {
    resetTTT();
    drawTTT();
    return;
  }
  if (p.x < 75 || p.x >= 246 || p.y < 42 || p.y >= 213) return;
  uint8_t col = (p.x - 75) / 57;
  uint8_t row = (p.y - 42) / 57;
  uint8_t idx = row * 3 + col;
  if (ttt[idx] != ' ') return;
  ttt[idx] = 'X';
  if (!tttWinner()) {
    for (uint8_t i = 0; i < 9; i++) {
      if (ttt[i] == ' ') {
        ttt[i] = 'O';
        break;
      }
    }
  }
  drawTTT();
}

void handlePong(const TouchPoint &p, bool touched) {
  if (touched && p.y > 40) pongPlayerX = constrain(p.x, 38, 282);
  if (millis() - lastGameTick > 30) {
    stepPong();
    paintPong();
    lastGameTick = millis();
  }
}

void handleApp(const TouchPoint &p, bool touched, bool justPressed) {
  if (backPressed(p, justPressed)) {
    drawLauncher();
    return;
  }
  if ((currentApp == APP_WIFI_SCAN || currentApp == APP_MARAUDER) && justPressed && inRect(p, {232, 31, 72, 24})) {
    drawWiFiList(currentApp == APP_WIFI_SCAN ? "WiFi Scanner" : "Safe Marauder Tools", currentApp == APP_MARAUDER);
  }
  if (currentApp == APP_CALC) handleCalc(p, justPressed);
  if (currentApp == APP_NOTES) handleNotes(p, justPressed);
  if (currentApp == APP_CLOCK && millis() - lastClockDraw > 1000) drawClock();
  if (currentApp == APP_WIFI_MANAGER) handleWiFiManager(p, justPressed);
  if (currentApp == APP_OTA) handleOTA(p, justPressed);
  if (currentApp == APP_SETTINGS) handleSettings(p, touched, justPressed);
  if (currentApp == APP_PAINT) handlePaint(p, touched, justPressed);
  if (currentApp == APP_TOUCH && touched && millis() - lastTouchDraw > 60) {
    drawTouchValues(p);
    lastTouchDraw = millis();
  }
  if (currentApp == APP_SNAKE) handleSnake(p, justPressed);
  if (currentApp == APP_TTT) handleTTT(p, justPressed);
  if (currentApp == APP_PONG) handlePong(p, touched);
}

void setup() {
  Serial.begin(115200);
  delay(200);
  randomSeed(analogRead(0));

  pinMode(PIN_TFT_CS, OUTPUT);
  pinMode(PIN_TOUCH_CS, OUTPUT);
  digitalWrite(PIN_TFT_CS, HIGH);
  digitalWrite(PIN_TOUCH_CS, HIGH);

  setupBacklight();
  SPI.begin(PIN_SPI_SCK, PIN_SPI_MISO, PIN_SPI_MOSI);
  tft.begin();
  tft.setRotation(DISPLAY_ROTATION);
  touch.begin();
  SPIFFS.begin(true);

  drawSplash();
  drawLauncher();
}

void loop() {
  if (otaReady) ArduinoOTA.handle();

  TouchPoint p = readTouch();
  bool oldTouch = touchWasDown;
  bool justPressed = p.down && !oldTouch && (millis() - lastTouchChange > 60);
  if (p.down != oldTouch) {
    touchWasDown = p.down;
    lastTouchChange = millis();
  }

  if (currentScreen == SCREEN_LAUNCHER) {
    handleLauncher(p, justPressed);
  } else {
    handleApp(p, p.down, justPressed);
  }

  delay(8);
}
