  tft.setTextSize(1);
  tft.setTextColor(cMuted());
  tft.setCursor(16, safeMode ? 80 : 60);
  tft.print("Scanning...");
  WiFi.mode(WIFI_STA);
  WiFi.disconnect(false);
  delay(100);
  int n = WiFi.scanNetworks();
  tft.fillRect(12, safeMode ? 78 : 58, 296, 128, cBg());
  if (n <= 0) {
    centeredText("No networks found", 0, 102, SCREEN_W, 16, cMuted(), 1);
